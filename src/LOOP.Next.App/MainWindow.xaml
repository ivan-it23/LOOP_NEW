<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LOOP_Next_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Кольца"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image
                Width="18"
                Height="18"
                Margin="16,0,10,0"
                VerticalAlignment="Center"
                Source="Assets/AppIcon.ico" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="Кольца" />
        </Grid>

        <!--
            Узел масштабирования содержимого. RenderTransform сам по себе не меняет
            разметку, поэтому кадру дополнительно задаётся размер рабочей области,
            делённый на масштаб: содержимое верстается в уменьшенной области и затем
            увеличивается. Это воспроизводит поведение layout-преобразования,
            которого нет в WinUI.
        -->
        <Grid
            x:Name="ContentScaleHost"
            Grid.Row="1"
            SizeChanged="OnContentScaleHostSizeChanged">
            <Frame
                x:Name="RootFrame"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                RenderTransformOrigin="0,0">
                <Frame.RenderTransform>
                    <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1" ScaleY="1" />
                </Frame.RenderTransform>
            </Frame>
        </Grid>
    </Grid>
</Window>
