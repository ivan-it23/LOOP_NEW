                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Серийный №" Style="{StaticResource IdentificationLabelTextStyle}" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
