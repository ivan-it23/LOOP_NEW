                        <ColumnDefinition Width="104*" />
                        <ColumnDefinition Width="130*" />
                        <ColumnDefinition Width="424*" />
                        <ColumnDefinition Width="88*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Text="Сопротивления резисторов кольца, Ом:"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        TextAlignment="Right"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="Black" />
                    <Border Grid.Column="4" Style="{StaticResource OldTableCellOutlineBorderStyle}">
                        <TextBlock Text="{x:Bind ViewModel.RingResistanceR1Text, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource OldTableCellOutlineBorderStyle}">
                        <TextBlock Text="{x:Bind ViewModel.RingResistanceR2Text, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource OldTableCellOutlineBorderStyle}">
                        <TextBlock Text="{x:Bind ViewModel.RingResistanceR3Text, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                    </Border>
                    <Border Grid.Column="7" Style="{StaticResource OldTableCellOutlineBorderStyle}">
                        <TextBlock Text="{x:Bind ViewModel.RingResistanceR4Text, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                    </Border>
                    <Border Grid.Column="8" Style="{StaticResource OldTableCellOutlineBorderStyle}">
                        <TextBlock Text="{x:Bind ViewModel.RingResistanceR5Text, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                    </Border>
                    <Border Grid.Column="9" Style="{StaticResource OldTableCellOutlineBorderStyle}">
                        <TextBlock Text="{x:Bind ViewModel.RingResistanceR6Text, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                    </Border>
                    <Border Grid.Column="10" Style="{StaticResource OldTableCellOutlineBorderStyle}">
                        <TextBlock Text="{x:Bind ViewModel.RingResistanceR7Text, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
