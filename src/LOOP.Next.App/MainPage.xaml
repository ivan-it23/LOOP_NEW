                                    <TextBlock Text="{x:Bind R7Text, Mode=OneWay}" Foreground="{x:Bind R7Foreground, Mode=OneWay}" Style="{StaticResource ResistanceTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="11" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R8Text, Mode=OneWay}" Foreground="{x:Bind R8Foreground, Mode=OneWay}" Style="{StaticResource ResistanceTableValueTextStyle}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid
