<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LOOP_Next_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:LOOP_Next_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LoopBandBrush" Color="#DCEBFF" />
                    <SolidColorBrush x:Key="LoopBandBorderBrush" Color="#7F9DBD" />
                    <SolidColorBrush x:Key="LoopAutoBrush" Color="#FFDADA" />
                    <SolidColorBrush x:Key="LoopAutoBorderBrush" Color="#D78484" />
                    <SolidColorBrush x:Key="LoopTableBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LoopBandBrush" Color="#1F344C" />
                    <SolidColorBrush x:Key="LoopBandBorderBrush" Color="#52708F" />
                    <SolidColorBrush x:Key="LoopAutoBrush" Color="#4B2C2C" />
                    <SolidColorBrush x:Key="LoopAutoBorderBrush" Color="#9D5A5A" />
                    <SolidColorBrush x:Key="LoopTableBrush" Color="#1B1B1B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <TabView
            TabWidthMode="SizeToContent"
            IsAddTabButtonVisible="False"
            SelectedIndex="0">

            <TabViewItem Header="Поверка">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{ThemeResource LoopBandBrush}"
                        BorderBrush="{ThemeResource LoopBandBorderBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" RowSpacing="8" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Усреднение:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Bind ViewModel.AveragingOptions}" SelectedItem="{x:Bind ViewModel.SelectedAveraging, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Порог %:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.ThresholdOptions}" SelectedItem="{x:Bind ViewModel.ThresholdPercent, Mode=TwoWay}" />
                            </Grid>

                            <Button
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.TogglePollingCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PollingText, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.PollingGlyph, Mode=OneWay}" FontSize="18" />
                            </Button>

                            <Grid Grid.Column="2" RowSpacing="8" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="148" />
                                    <ColumnDefinition Width="156" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="{x:Bind ViewModel.ToolToggleText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanToggleTool, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleToolCommand}" />
                                <Button Grid.Row="0" Grid.Column="1" Content="{x:Bind ViewModel.RingToggleText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanToggleRing, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleRingCommand}" />
                                <Button Grid.Row="0" Grid.Column="2" Content="Локальный воздух" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" Command="{x:Bind ViewModel.LocalAirCommand}" />

                                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{x:Bind ViewModel.ToolPorts}" SelectedItem="{x:Bind ViewModel.SelectedToolPort, Mode=TwoWay}" PlaceholderText="COM прибора" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.RingPorts}" SelectedItem="{x:Bind ViewModel.SelectedRingPort, Mode=TwoWay}" PlaceholderText="COM кольца" />
                                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{x:Bind ViewModel.FrameCountOptions}" SelectedItem="{x:Bind ViewModel.SelectedFrameCount, Mode=TwoWay}" PlaceholderText="Кол-во кадров" />
                                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{x:Bind ViewModel.PollIntervalOptions}" SelectedItem="{x:Bind ViewModel.PollIntervalMs, Mode=TwoWay}" PlaceholderText="Интервал, мс" />
                                <Button Grid.Row="1" Grid.Column="4" Command="{x:Bind ViewModel.RefreshPortsCommand}" ToolTipService.ToolTip="Обновить список COM-портов" HorizontalAlignment="Left" Padding="8,4">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>

                            <ToggleButton
                                Grid.Column="3"
                                Width="120"
                                Height="56"
                                VerticalAlignment="Center"
                                Background="{ThemeResource LoopAutoBrush}"
                                BorderBrush="{ThemeResource LoopAutoBorderBrush}"
                                IsChecked="{x:Bind ViewModel.IsAutoMode, Mode=TwoWay}">
                                <TextBlock Text="Режим&#x0a;АВТО" TextAlignment="Center" />
                            </ToggleButton>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource LoopTableBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Фазы по каналам, мГ" Style="{StaticResource SubtitleTextBlockStyle}" />

                            <Grid Grid.Row="1" Padding="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Канал" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="Сырое" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="Воздух" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="Скорр." Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>

                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Channels}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="Padding" Value="8,4" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChannelReadingViewModel">
                                        <Grid Padding="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind RawText, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind AirText, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind CorrectedText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Background="{ThemeResource LoopBandBrush}"
                        BorderBrush="{ThemeResource LoopBandBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="8">
                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Идентификация зонда" Style="{StaticResource CaptionTextBlockStyle}" />

                                <Grid Grid.Row="1" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ToolTypeName, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TransmitterCountText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ModificationText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.NumberText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.RxPositionText, Mode=OneWay}" />
                                </Grid>

                                <Grid Grid.Row="2" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SignatureText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PaletteText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.FrameCount, Mode=OneWay}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.LocalAirState, Mode=OneWay}" />
                                </Grid>
                            </Grid>

                            <Button Grid.Column="1" Content="Рапорт" Command="{x:Bind ViewModel.ReportCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <InfoBar Grid.Row="3" IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Поверка кольца">
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Поверка кольца" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />

                    <Grid Grid.Row="1" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                            <Grid RowSpacing="8" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Геометрия зонда" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="L1, мм" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="L2, мм" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="T1" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" />
                                <TextBox Grid.Row="2" Grid.Column="2" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="T2" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" />
                                <TextBox Grid.Row="3" Grid.Column="2" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="T3" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" />
                                <TextBox Grid.Row="4" Grid.Column="2" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="T4" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" />
                                <TextBox Grid.Row="5" Grid.Column="2" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="T5" VerticalAlignment="Center" />
                                <TextBox Grid.Row="6" Grid.Column="1" />
                                <TextBox Grid.Row="6" Grid.Column="2" />
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="F1/F2" VerticalAlignment="Center" />
                                <TextBox Grid.Row="7" Grid.Column="1" PlaceholderText="F1, кГц" />
                                <TextBox Grid.Row="7" Grid.Column="2" PlaceholderText="F2, кГц" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                            <Grid RowSpacing="10" ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Расчёт ёмкостей" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="C_req, pF" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="RE_calc, ohm" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="R, ohm" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Re meas" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" />
                                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Рассчитать" />
                                    <Button Content="Прочитать" />
                                    <Button Content="Записать" />
                                    <CheckBox Content="Редактировать" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Идентификация зонда" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ToolTypeName, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TransmitterCountText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ModificationText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.NumberText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.RxPositionText, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SignatureText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PaletteText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Метрология -> Зонд" />
                            <Button Content="Метрология -> Файл" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Настройки">
                <Grid Padding="24">
                    <StackPanel Width="360" HorizontalAlignment="Left" Spacing="16">
                        <TextBlock Text="Настройки" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Прибор" Style="{StaticResource CaptionTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Интервал опроса:" VerticalAlignment="Center" />
                                    <ComboBox Width="100" ItemsSource="{x:Bind ViewModel.PollIntervalOptions}" SelectedItem="{x:Bind ViewModel.PollIntervalMs, Mode=TwoWay}" />
                                    <TextBlock Text="мс" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ConnectionStateText, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.FrameCount, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Режим измерений" Style="{StaticResource CaptionTextBlockStyle}" />
                                <ToggleSwitch Header="Экспресс" IsOn="{x:Bind ViewModel.ExpressMode, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
