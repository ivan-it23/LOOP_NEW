<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LOOP_Next_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:LOOP_Next_App.ViewModels"
    xmlns:controls="using:LOOP_Next_App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="LoopBandBrush" Color="#F4F4F4" />
        <SolidColorBrush x:Key="LoopBandBorderBrush" Color="#C8C8C8" />
        <SolidColorBrush x:Key="OldTableBorderBrush" Color="#9A9A9A" />
        <SolidColorBrush x:Key="OldTableBackgroundBrush" Color="#F1F1F1" />
        <SolidColorBrush x:Key="OldTableCellBrush" Color="#FFFFFF" />

        <Style x:Key="OldTableCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource OldTableBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource OldTableCellBrush}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="OldTableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OldTableCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OldTableValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="OldTableTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="RingValueTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="RootTabs"
            Grid.Row="0"
            TabWidthMode="SizeToContent"
            IsAddTabButtonVisible="False"
            SelectedIndex="0"
            SelectionChanged="RootTabs_SelectionChanged"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <TabViewItem Header="Главная" IsClosable="False" />
            <TabViewItem Header="Поверка кольца" IsClosable="False" />
            <TabViewItem Header="Настройки" IsClosable="False" />
        </TabView>

        <Border
            x:Name="MainConnectionPanel"
            Grid.Row="1"
            Background="{StaticResource LoopBandBrush}"
            BorderBrush="{StaticResource LoopBandBorderBrush}"
            BorderThickness="0,1,0,1"
            Padding="6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="6" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Усреднение:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="88" ItemsSource="{x:Bind ViewModel.AveragingOptions}" SelectedItem="{x:Bind ViewModel.SelectedAveraging, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Порог %:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Width="88" ItemsSource="{x:Bind ViewModel.ThresholdOptions}" SelectedItem="{x:Bind ViewModel.ThresholdPercent, Mode=TwoWay}" />
                </Grid>

                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Margin="6,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    Command="{x:Bind ViewModel.TogglePollingCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PollingText, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.PollingGlyph, Mode=OneWay}" FontSize="13" />
                </Button>

                <StackPanel Grid.Column="2" Spacing="4">
                    <Button
                        Width="150"
                        Content="{x:Bind ViewModel.ToolToggleText, Mode=OneWay}"
                        Background="{x:Bind ViewModel.ToolButtonBackground, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanToggleTool, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleToolCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox
                            Width="150"
                            ItemsSource="{x:Bind ViewModel.ToolPorts}"
                            SelectedItem="{x:Bind ViewModel.SelectedToolPort, Mode=TwoWay}"
                            PlaceholderText="COM прибора" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{x:Bind ViewModel.RefreshPortsCommand}"
                            ToolTipService.ToolTip="Обновить COM-порты прибора">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="4">
                    <Button
                        Width="150"
                        Content="{x:Bind ViewModel.RingToggleText, Mode=OneWay}"
                        Background="{x:Bind ViewModel.RingButtonBackground, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanToggleRing, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleRingCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox
                            Width="150"
                            ItemsSource="{x:Bind ViewModel.RingPorts}"
                            SelectedItem="{x:Bind ViewModel.SelectedRingPort, Mode=TwoWay}"
                            PlaceholderText="COM кольца" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{x:Bind ViewModel.RefreshPortsCommand}"
                            ToolTipService.ToolTip="Обновить COM-порты кольца">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" Spacing="4">
                    <Button
                        Width="148"
                        Content="{x:Bind ViewModel.LocalAirButtonText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                        Command="{x:Bind ViewModel.LocalAirCommand}" />
                    <ComboBox
                        Width="148"
                        ItemsSource="{x:Bind ViewModel.FrameCountOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedFrameCount, Mode=TwoWay}"
                        PlaceholderText="Кол-во кадров" />
                </StackPanel>

                <ToggleButton
                    Grid.Column="5"
                    Width="148"
                    Height="32"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.CanToggleAutoMode, Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.IsAutoMode, Mode=TwoWay}">
                    <TextBlock Text="Режим АВТО" TextAlignment="Center" />
                </ToggleButton>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="MainResistanceTable"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid
                MinWidth="1400"
                Background="{StaticResource OldTableBackgroundBrush}"
                Padding="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="424" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="№ Зонда" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="{x:Bind ViewModel.AirColumnBackground, Mode=OneWay}" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="AIR" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ScaleMinus3PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ScaleMinus2PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ScaleMinus1PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.ScalePlus1PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.ScalePlus2PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.ScalePlus3PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="УЭС Ом" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid ColumnSpacing="2" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind ViewModel.ReportR1Selected, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="R1 в рапорт" />
                        <Button
                            Grid.Column="1"
                            Content="R1"
                            Command="{x:Bind ViewModel.RunResistanceCommand}"
                            CommandParameter="1"
                            IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid ColumnSpacing="2" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind ViewModel.ReportR2Selected, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="R2 в рапорт" />
                        <Button
                            Grid.Column="1"
                            Content="R2"
                            Command="{x:Bind ViewModel.RunResistanceCommand}"
                            CommandParameter="2"
                            IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="6" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid ColumnSpacing="2" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind ViewModel.ReportR3Selected, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="R3 в рапорт" />
                        <Button
                            Grid.Column="1"
                            Content="R3"
                            Command="{x:Bind ViewModel.RunResistanceCommand}"
                            CommandParameter="3"
                            IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="7" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid ColumnSpacing="2" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind ViewModel.ReportR4Selected, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="R4 в рапорт" />
                        <Button
                            Grid.Column="1"
                            Content="R4"
                            Command="{x:Bind ViewModel.RunResistanceCommand}"
                            CommandParameter="4"
                            IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="8" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid ColumnSpacing="2" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind ViewModel.ReportR5Selected, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="R5 в рапорт" />
                        <Button
                            Grid.Column="1"
                            Content="R5"
                            Command="{x:Bind ViewModel.RunResistanceCommand}"
                            CommandParameter="5"
                            IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="9" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid ColumnSpacing="2" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind ViewModel.ReportR6Selected, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="R6 в рапорт" />
                        <Button
                            Grid.Column="1"
                            Content="R6"
                            Command="{x:Bind ViewModel.RunResistanceCommand}"
                            CommandParameter="6"
                            IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="10" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid ColumnSpacing="2" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind ViewModel.ReportR7Selected, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="R7 в рапорт" />
                        <Button
                            Grid.Column="1"
                            Content="R7"
                            Command="{x:Bind ViewModel.RunResistanceCommand}"
                            CommandParameter="7"
                            IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="11" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid ColumnSpacing="2" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind ViewModel.ReportR8Selected, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="R8 в рапорт" />
                        <Button
                            Grid.Column="1"
                            Content="R8"
                            Command="{x:Bind ViewModel.RunResistanceCommand}"
                            CommandParameter="8"
                            IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold" />
                    </Grid>
                </Border>

                <ItemsControl
                    Grid.Row="1"
                    Grid.ColumnSpan="12"
                    ItemsSource="{x:Bind ViewModel.ResistanceRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResistanceTableRowViewModel">
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="94" />
                                    <ColumnDefinition Width="424" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind SondeLabel}" Style="{StaticResource OldTableCellTextStyle}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind AirText, Mode=OneWay}" Style="{StaticResource OldTableCellTextStyle}" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource OldTableCellBorderStyle}" Padding="4">
                                    <controls:MeasurementIndicator
                                        Value="{x:Bind IndicatorValue, Mode=OneWay}"
                                        AverageValue="{x:Bind IndicatorAverageValue, Mode=OneWay}"
                                        Threshold="{x:Bind IndicatorThreshold, Mode=OneWay}" />
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind UesText, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R1Text, Mode=OneWay}" Foreground="{x:Bind R1Foreground, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="5" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R2Text, Mode=OneWay}" Foreground="{x:Bind R2Foreground, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="6" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R3Text, Mode=OneWay}" Foreground="{x:Bind R3Foreground, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="7" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R4Text, Mode=OneWay}" Foreground="{x:Bind R4Foreground, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="8" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R5Text, Mode=OneWay}" Foreground="{x:Bind R5Foreground, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="9" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R6Text, Mode=OneWay}" Foreground="{x:Bind R6Foreground, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="10" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R7Text, Mode=OneWay}" Foreground="{x:Bind R7Foreground, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="11" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R8Text, Mode=OneWay}" Foreground="{x:Bind R8Foreground, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </ScrollViewer>

        <Border
            x:Name="MainIdentificationPanel"
            Grid.Row="3"
            Background="{StaticResource LoopBandBrush}"
            BorderBrush="{StaticResource LoopBandBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="8">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Идентификация зонда" Style="{StaticResource CaptionTextBlockStyle}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock><Run Text="Тип: " /><Run Text="{x:Bind ViewModel.ToolTypeName, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Кол-во TX: " /><Run Text="{x:Bind ViewModel.TransmitterCountText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Модификация: " /><Run Text="{x:Bind ViewModel.ModificationText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Номер: " /><Run Text="{x:Bind ViewModel.NumberText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Серийный №: " /><Run Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Позиция R1: " /><Run Text="{x:Bind ViewModel.RxPositionText, Mode=OneWay}" /></TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                        <TextBlock><Run Text="Сигнатура: " /><Run Text="{x:Bind ViewModel.SignatureText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Pallet: " /><Run Text="{x:Bind ViewModel.PaletteText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Кадров принято: " /><Run Text="{x:Bind ViewModel.FrameCount, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Локальный воздух: " /><Run Text="{x:Bind ViewModel.LocalAirState, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Grid>

                <Button
                    Grid.Column="1"
                    Content="Рапорт"
                    Command="{x:Bind ViewModel.ReportCommand}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </Border>

        <Grid
            x:Name="RingVerificationContent"
            Grid.Row="1"
            Grid.RowSpan="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Padding="16"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer
                Grid.Row="0"
                Grid.RowSpan="3"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid Width="1080" HorizontalAlignment="Left" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="800" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Padding="6">
                        <Grid RowSpacing="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Геометрия зонда" FontSize="12" />
                            <Grid Grid.Row="1" Margin="0,2,0,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="L1, мм" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="L2, мм" FontSize="12" HorizontalAlignment="Center" />

                                <ItemsControl
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    ItemsSource="{x:Bind ViewModel.RingGeometryRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RingCalibrationRowViewModel">
                                            <Grid Height="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="82" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Style="{StaticResource RingValueTextBoxStyle}"
                                                    IsReadOnly="True"
                                                    Text="{x:Bind L1Text, Mode=OneWay}"
                                                    TextAlignment="Center" />
                                                <TextBox
                                                    Grid.Column="2"
                                                    Style="{StaticResource RingValueTextBoxStyle}"
                                                    IsReadOnly="True"
                                                    Text="{x:Bind L2Text, Mode=OneWay}"
                                                    TextAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <ItemsControl
                                Grid.Row="2"
                                ItemsSource="{x:Bind ViewModel.RingFrequencyRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RingCalibrationRowViewModel">
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="82" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBox
                                                Grid.Column="1"
                                                Style="{StaticResource RingValueTextBoxStyle}"
                                                IsReadOnly="True"
                                                Text="{x:Bind FrequencyText, Mode=OneWay}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Padding="6">
                        <Grid RowSpacing="7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Расчёт ёмкостей" FontSize="12" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="C_req, Pf" FontSize="12" VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.RingCalibrationRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RingCalibrationRowViewModel">
                                            <TextBox
                                                Style="{StaticResource RingValueTextBoxStyle}"
                                                IsReadOnly="{x:Bind IsRingValueReadOnly, Mode=OneWay}"
                                                Text="{x:Bind CapacitanceText, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RE_calk, ohm" FontSize="12" VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.RingCalibrationRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RingCalibrationRowViewModel">
                                            <TextBox
                                                Style="{StaticResource RingValueTextBoxStyle}"
                                                IsReadOnly="{x:Bind IsRingValueReadOnly, Mode=OneWay}"
                                                Text="{x:Bind ReactanceCalculatedText, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="R, ohm" FontSize="12" VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.RingResistanceRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RingCalibrationRowViewModel">
                                            <TextBox
                                                Style="{StaticResource RingValueTextBoxStyle}"
                                                IsReadOnly="{x:Bind IsRingValueReadOnly, Mode=OneWay}"
                                                Text="{x:Bind ResistanceText, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Re meas" FontSize="12" VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.RingCalibrationRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RingCalibrationRowViewModel">
                                            <TextBox
                                                Style="{StaticResource RingValueTextBoxStyle}"
                                                IsReadOnly="{x:Bind IsRingValueReadOnly, Mode=OneWay}"
                                                Text="{x:Bind ReactanceMeasuredText, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Content="Рассчитать" Command="{x:Bind ViewModel.CalculateRingCalibrationCommand}" />
                                <Button Content="Прочитать" Command="{x:Bind ViewModel.ReadRingParametersCommand}" />
                                <Button Content="Записать" Command="{x:Bind ViewModel.WriteRingParametersCommand}" />
                            </StackPanel>

                            <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                <TextBlock Text="Редактировать" FontSize="12" VerticalAlignment="Center" />
                                <CheckBox IsChecked="{x:Bind ViewModel.IsRingEditMode, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Padding="6">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Идентификация зонда" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="12"><Run Text="Тип: " /><Run Text="{x:Bind ViewModel.ToolTypeName, Mode=OneWay}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Кол-во TX: " /><Run Text="{x:Bind ViewModel.TransmitterCountText, Mode=OneWay}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Модификация: " /><Run Text="{x:Bind ViewModel.ModificationText, Mode=OneWay}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Номер: " /><Run Text="{x:Bind ViewModel.NumberText, Mode=OneWay}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Серийный №: " /><Run Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Позиция R1: " /><Run Text="{x:Bind ViewModel.RxPositionText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="12"><Run Text="Сигнатура: " /><Run Text="{x:Bind ViewModel.SignatureText, Mode=OneWay}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Pallet: " /><Run Text="{x:Bind ViewModel.PaletteText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Метрология -> Зонд" Command="{x:Bind ViewModel.ReadMetrologyFromToolCommand}" />
                        <Button Content="Метрология -> Файл" Click="ReadMetrologyFromFile_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer
                Visibility="Collapsed"
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Grid MinWidth="900" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        BorderBrush="{StaticResource LoopBandBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource LoopBandBrush}"
                        Padding="10">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Геометрия зонда" FontWeight="SemiBold" />
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="№" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="L1, м" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="L2, м" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="F, кГц" FontWeight="SemiBold" />

                                <ItemsControl
                                    Grid.Row="1"
                                    Grid.ColumnSpan="4"
                                    ItemsSource="{x:Bind ViewModel.RingCalibrationRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RingCalibrationRowViewModel">
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind L1Text, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind L2Text, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind FrequencyText, Mode=OneWay}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        BorderBrush="{StaticResource LoopBandBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource LoopBandBrush}"
                        Padding="10">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Расчёт ёмкостей" FontWeight="SemiBold" />
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="№" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="C_req, пФ" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="RE_calc" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="R, Ом" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Re meas" FontWeight="SemiBold" />

                                <ItemsControl
                                    Grid.Row="1"
                                    Grid.ColumnSpan="5"
                                    ItemsSource="{x:Bind ViewModel.RingCalibrationRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RingCalibrationRowViewModel">
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="86" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind CapacitanceText, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ReactanceCalculatedText, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind ResistanceText, Mode=OneWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind ReactanceMeasuredText, Mode=OneWay}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Рассчитать" Command="{x:Bind ViewModel.CalculateRingCalibrationCommand}" />
                                <Button Content="Прочитать" Command="{x:Bind ViewModel.ReadRingParametersCommand}" />
                                <Button Content="Записать" Command="{x:Bind ViewModel.WriteRingParametersCommand}" />
                                <CheckBox Content="Редактировать" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        BorderBrush="{StaticResource LoopBandBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource LoopBandBrush}"
                        Padding="10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Идентификация зонда" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock><Run Text="Тип: " /><Run Text="{x:Bind ViewModel.ToolTypeName, Mode=OneWay}" /></TextBlock>
                                <TextBlock><Run Text="Кол-во TX: " /><Run Text="{x:Bind ViewModel.TransmitterCountText, Mode=OneWay}" /></TextBlock>
                                <TextBlock><Run Text="Модификация: " /><Run Text="{x:Bind ViewModel.ModificationText, Mode=OneWay}" /></TextBlock>
                                <TextBlock><Run Text="Номер: " /><Run Text="{x:Bind ViewModel.NumberText, Mode=OneWay}" /></TextBlock>
                                <TextBlock><Run Text="Серийный №: " /><Run Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" /></TextBlock>
                                <TextBlock><Run Text="Позиция R1: " /><Run Text="{x:Bind ViewModel.RxPositionText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock><Run Text="Сигнатура: " /><Run Text="{x:Bind ViewModel.SignatureText, Mode=OneWay}" /></TextBlock>
                                <TextBlock><Run Text="Pallet: " /><Run Text="{x:Bind ViewModel.PaletteText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Метрология -> Зонд" />
                        <Button Content="Метрология -> Файл" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border
                Visibility="Collapsed"
                Grid.Row="2"
                Margin="0,16,0,0"
                BorderBrush="{StaticResource LoopBandBorderBrush}"
                BorderThickness="1"
                Background="{StaticResource LoopBandBrush}"
                Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Параметры поверки" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Порог, %" VerticalAlignment="Center" />
                        <ComboBox
                            Width="96"
                            ItemsSource="{x:Bind ViewModel.ThresholdOptions}"
                            SelectedItem="{x:Bind ViewModel.ThresholdPercent, Mode=TwoWay}" />
                        <TextBlock Text="Усреднение" VerticalAlignment="Center" />
                        <ComboBox
                            Width="96"
                            ItemsSource="{x:Bind ViewModel.AveragingOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedAveraging, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="SettingsContent"
            Grid.Row="1"
            Grid.RowSpan="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Padding="16"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" />

            <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Интервал опроса, мс" VerticalAlignment="Center" />
                <NumberBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="160"
                    Minimum="700"
                    SmallChange="100"
                    LargeChange="500"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.PollIntervalMs, Mode=TwoWay}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Экспресс" VerticalAlignment="Center" />
                <ToggleSwitch
                    Grid.Row="1"
                    Grid.Column="1"
                    IsOn="{x:Bind ViewModel.ExpressMode, Mode=TwoWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
