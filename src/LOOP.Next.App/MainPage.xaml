                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R1Text, Mode=OneWay}" Foreground="{x:Bind R1Foreground, Mode=OneWay}" Style="{StaticResource ResistanceTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="5" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R2Text, Mode=OneWay}" Foreground="{x:Bind R2Foreground, Mode=OneWay}" Style="{StaticResource ResistanceTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="6" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R3Text, Mode=OneWay}" Foreground="{x:Bind R3Foreground, Mode=OneWay}" Style="{StaticResource ResistanceTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="7" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R4Text, Mode=OneWay}" Foreground="{x:Bind R4Foreground, Mode=OneWay}" Style="{StaticResource ResistanceTableValueTextStyle}" />
                                </Border>
                                <Border Grid.Column="8" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind R5Text, Mode=OneWay}" Foreground="{x:Bind R5Foreground, Mode=OneWay}" Style="{StaticResource ResistanceTableValueTextStyle}" />
                                </Border>
