                    <Border Grid.Column="11" Style="{StaticResource OldTableCellOutlineBorderStyle}">
                        <TextBlock Text="{x:Bind ViewModel.RingResistanceR8Text, Mode=OneWay}" Style="{StaticResource OldTableValueTextStyle}" />
                    </Border>
                </Grid>

                </Grid>
            </ScrollViewer>

            <Grid
                x:Name="MainIdentificationPanel"
                Grid.Row="1"
                Margin="6,0,6,0"
                ColumnSpacing="12"
                VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Left">
                    <Border
                        Width="{x:Bind ViewModel.IdentificationPanelWidth, Mode=OneWay}"
                        Style="{StaticResource IdentificationPanelBorderStyle}">
                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Width="3"
                            Background="{ThemeResource SystemControlForegroundAccentBrush}"
                            CornerRadius="2"
                            Opacity="0.72" />

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Идентификация зонда"
                            Style="{StaticResource IdentificationSectionHeaderTextStyle}" />

                        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="6" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Левый столбец: тип прибора, серийный номер, сигнатура. -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип" Style="{StaticResource IdentificationLabelTextStyle}" />
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ToolTypeName, Mode=OneWay}"
                                    Style="{StaticResource IdentificationValueTextStyle}" />
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Серийный №" Style="{StaticResource IdentificationLabelTextStyle}" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SerialText, Mode=OneWay}"
                                    Style="{StaticResource IdentificationValueTextStyle}"
                                    FontFamily="Consolas" />
                            </Border>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Сигнатура" Style="{StaticResource IdentificationLabelTextStyle}" />
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SignatureText, Mode=OneWay}"
                                    Style="{StaticResource IdentificationValueTextStyle}"
                                    FontFamily="Consolas" />
                            </Border>

                            <!-- Правый столбец: номер, модификация, позиция R1. -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="6,0,0,0" Text="Номер" Style="{StaticResource IdentificationLabelTextStyle}" />
                            <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.NumberText, Mode=OneWay}"
                                    Style="{StaticResource IdentificationValueTextStyle}" />
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" Text="Модификация" Style="{StaticResource IdentificationLabelTextStyle}" />
                            <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ModificationText, Mode=OneWay}"
                                    Style="{StaticResource IdentificationValueTextStyle}" />
                            </Border>

                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="6,0,0,0" Text="Позиция R1" Style="{StaticResource IdentificationLabelTextStyle}" />
                            <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.RxPositionText, Mode=OneWay}"
                                    Style="{StaticResource IdentificationValueTextStyle}" />
                            </Border>
                        </Grid>
                    </Grid>
                    </Border>

                    <!-- Карточка состояния: локальный воздух, счётчик кадров и температура прибора. -->
                    <Border
                        x:Name="MainSondeStatePanel"
                        Width="200"
                        Style="{StaticResource IdentificationPanelBorderStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="Состояние зонда"
                            Style="{StaticResource IdentificationSectionHeaderTextStyle}" />

                        <Grid Grid.Row="1" RowSpacing="6" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Воздух:" Style="{StaticResource IdentificationLabelTextStyle}" />
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.LocalAirState, Mode=OneWay}"
                                    Style="{StaticResource IdentificationValueTextStyle}"
                                    AutomationProperties.Name="Состояние локального воздуха" />
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Кадров:" Style="{StaticResource IdentificationLabelTextStyle}" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.FrameCount, Mode=OneWay}"
                                    Style="{StaticResource IdentificationValueTextStyle}"
                                    AutomationProperties.Name="Количество кадров" />
                            </Border>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Температура:" Style="{StaticResource IdentificationLabelTextStyle}" />
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.TemperatureText, Mode=OneWay}"
                                    Style="{StaticResource IdentificationValueTextStyle}"
                                    AutomationProperties.Name="Температура зонда" />
                            </Border>
                        </Grid>
                    </Grid>
                    </Border>
                </StackPanel>

                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Height="{Binding ActualHeight, ElementName=MainSondeStatePanel}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource IdentificationPanelBorderStyle}">
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Width="3"
                                Background="{ThemeResource SystemControlForegroundAccentBrush}"
                                CornerRadius="2"
                                Opacity="0.72" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="Состояние кольца"
                                Style="{StaticResource IdentificationSectionHeaderTextStyle}" />

                            <Grid Grid.Row="1" Grid.Column="1" RowSpacing="6" ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Сигнатура:" Style="{StaticResource IdentificationLabelTextStyle}" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.RingSignatureText, Mode=OneWay}"
                                        Style="{StaticResource IdentificationValueTextStyle}"
                                        FontFamily="Consolas"
                                        AutomationProperties.Name="Значение сигнатуры кольца" />
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ёмкости:" Style="{StaticResource IdentificationLabelTextStyle}" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.RingCapacitanceStateText, Mode=OneWay}"
                                        Style="{StaticResource IdentificationValueTextStyle}"
                                        AutomationProperties.Name="Состояние расчёта ёмкостей кольца" />
                                </Border>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Поддержка типов:" Style="{StaticResource IdentificationLabelTextStyle}" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource IdentificationCompactValueBorderStyle}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.RingSupportedToolTypesText, Mode=OneWay}"
                                        Style="{StaticResource IdentificationValueTextStyle}"
                                        TextWrapping="NoWrap"
                                        TextTrimming="None"
                                        AutomationProperties.Name="Поддерживаемые типы приборов кольца" />
                                </Border>
                            </Grid>
                        </Grid>
                </Border>

                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Width="108"
                    Height="35"
                    Margin="0,8,0,0"
                    Content="Рапорт"
                    Click="Report_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontWeight="Bold"
                    ToolTipService.ToolTip="Сформировать рапорт" />
            </Grid>
        </Grid>

        <Grid
            x:Name="RingVerificationContent"
            Grid.Row="1"
            Grid.RowSpan="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Padding="16"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer
                Grid.Row="0"
                Grid.RowSpan="3"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Stretch" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25*" />
                        <ColumnDefinition Width="75*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Style="{StaticResource RingCardBorderStyle}">
                        <Grid RowSpacing="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="3" Height="14" Background="{ThemeResource SystemControlForegroundAccentBrush}" CornerRadius="2" Opacity="0.72" />
                                <TextBlock Text="Геометрия зонда" Style="{StaticResource RingSectionHeaderTextStyle}" />
                            </StackPanel>
