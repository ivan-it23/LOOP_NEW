<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LOOP_Next_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:LOOP_Next_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="LoopBandBrush" Color="#DCEBFF" />
        <SolidColorBrush x:Key="LoopBandBorderBrush" Color="#7F9DBD" />
        <SolidColorBrush x:Key="LoopAutoBrush" Color="#FFDADA" />
        <SolidColorBrush x:Key="LoopAutoBorderBrush" Color="#D78484" />
        <SolidColorBrush x:Key="OldTableBorderBrush" Color="#9A9A9A" />
        <SolidColorBrush x:Key="OldTableBackgroundBrush" Color="#F1F1F1" />
        <SolidColorBrush x:Key="OldTableCellBrush" Color="#FFFFFF" />

        <Style x:Key="OldTableCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource OldTableBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource OldTableCellBrush}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="OldTableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OldTableCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OldTableTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView
            Grid.Row="0"
            TabWidthMode="SizeToContent"
            IsAddTabButtonVisible="False"
            SelectedIndex="-1"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <TabViewItem Header="Поверка кольца" IsClosable="False" />
            <TabViewItem Header="Настройки" IsClosable="False" />
        </TabView>

        <Border
            Grid.Row="1"
            Background="{StaticResource LoopBandBrush}"
            BorderBrush="{StaticResource LoopBandBorderBrush}"
            BorderThickness="0,1,0,1"
            Padding="6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="6" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Усреднение:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Bind ViewModel.AveragingOptions}" SelectedItem="{x:Bind ViewModel.SelectedAveraging, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Порог %:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.ThresholdOptions}" SelectedItem="{x:Bind ViewModel.ThresholdPercent, Mode=TwoWay}" />
                </Grid>

                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    Command="{x:Bind ViewModel.TogglePollingCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PollingText, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.PollingGlyph, Mode=OneWay}" FontSize="13" />
                </Button>

                <StackPanel Grid.Column="2" Spacing="4">
                    <Button
                        Width="112"
                        Content="{x:Bind ViewModel.ToolToggleText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanToggleTool, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleToolCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox
                            Width="112"
                            ItemsSource="{x:Bind ViewModel.ToolPorts}"
                            SelectedItem="{x:Bind ViewModel.SelectedToolPort, Mode=TwoWay}"
                            PlaceholderText="COM прибора" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{x:Bind ViewModel.RefreshPortsCommand}"
                            ToolTipService.ToolTip="Обновить COM-порты прибора">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="4">
                    <Button
                        Width="112"
                        Content="{x:Bind ViewModel.RingToggleText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanToggleRing, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleRingCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox
                            Width="112"
                            ItemsSource="{x:Bind ViewModel.RingPorts}"
                            SelectedItem="{x:Bind ViewModel.SelectedRingPort, Mode=TwoWay}"
                            PlaceholderText="COM кольца" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{x:Bind ViewModel.RefreshPortsCommand}"
                            ToolTipService.ToolTip="Обновить COM-порты кольца">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" Spacing="4">
                    <Button
                        Width="148"
                        Content="Локальный воздух"
                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                        Command="{x:Bind ViewModel.LocalAirCommand}" />
                    <ComboBox
                        Width="148"
                        ItemsSource="{x:Bind ViewModel.FrameCountOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedFrameCount, Mode=TwoWay}"
                        PlaceholderText="Кол-во кадров" />
                </StackPanel>

                <StackPanel Grid.Column="5" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Интервал опроса, мс" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox
                        Width="150"
                        ItemsSource="{x:Bind ViewModel.PollIntervalOptions}"
                        SelectedItem="{x:Bind ViewModel.PollIntervalMs, Mode=TwoWay}" />
                </StackPanel>

                <ToggleButton
                    Grid.Column="6"
                    Width="120"
                    Height="56"
                    VerticalAlignment="Center"
                    Background="{StaticResource LoopAutoBrush}"
                    BorderBrush="{StaticResource LoopAutoBorderBrush}"
                    IsChecked="{x:Bind ViewModel.IsAutoMode, Mode=TwoWay}">
                    <TextBlock Text="Режим&#x0a;АВТО" TextAlignment="Center" />
                </ToggleButton>

                <ToggleSwitch
                    Grid.Column="7"
                    Header="Экспресс"
                    IsOn="{x:Bind ViewModel.ExpressMode, Mode=TwoWay}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid
                MinWidth="1400"
                Background="{StaticResource OldTableBackgroundBrush}"
                Padding="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="424" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="№ Зонда" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="AIR" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource OldTableCellBorderStyle}">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="-90mG" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="1" Text="-60mG" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="2" Text="-30mG" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="3" Text="30mG" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="4" Text="60mG" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                        <TextBlock Grid.Column="5" Text="90mG" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="14" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="УЭС Ом" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="R1" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="R2" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="6" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="R3" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="7" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="R4" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="8" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="R5" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="9" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="R6" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="10" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="R7" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="11" Style="{StaticResource OldTableCellBorderStyle}">
                    <TextBlock Text="R8" Style="{StaticResource OldTableHeaderTextStyle}" />
                </Border>

                <ItemsControl
                    Grid.Row="1"
                    Grid.ColumnSpan="12"
                    ItemsSource="{x:Bind ViewModel.ResistanceRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResistanceTableRowViewModel">
                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="94" />
                                    <ColumnDefinition Width="424" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind SondeLabel}" Style="{StaticResource OldTableCellTextStyle}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource OldTableCellBorderStyle}">
                                    <TextBlock Text="{x:Bind AirText, Mode=OneWay}" Style="{StaticResource OldTableCellTextStyle}" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource OldTableCellBorderStyle}" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="Red" />
                                        <Border Grid.Column="1" Background="Yellow" />
                                        <Border Grid.Column="2" Background="LimeGreen" />
                                        <Border Grid.Column="3" Background="Yellow" />
                                        <Border Grid.Column="4" Background="Red" />
                                    </Grid>
                                </Border>
                                <TextBox Grid.Column="3" Text="{x:Bind UesText, Mode=TwoWay}" Style="{StaticResource OldTableTextBoxStyle}" />
                                <TextBox Grid.Column="4" Text="{x:Bind R1Text, Mode=TwoWay}" Style="{StaticResource OldTableTextBoxStyle}" />
                                <TextBox Grid.Column="5" Text="{x:Bind R2Text, Mode=TwoWay}" Style="{StaticResource OldTableTextBoxStyle}" />
                                <TextBox Grid.Column="6" Text="{x:Bind R3Text, Mode=TwoWay}" Style="{StaticResource OldTableTextBoxStyle}" />
                                <TextBox Grid.Column="7" Text="{x:Bind R4Text, Mode=TwoWay}" Style="{StaticResource OldTableTextBoxStyle}" />
                                <TextBox Grid.Column="8" Text="{x:Bind R5Text, Mode=TwoWay}" Style="{StaticResource OldTableTextBoxStyle}" />
                                <TextBox Grid.Column="9" Text="{x:Bind R6Text, Mode=TwoWay}" Style="{StaticResource OldTableTextBoxStyle}" />
                                <TextBox Grid.Column="10" Text="{x:Bind R7Text, Mode=TwoWay}" Style="{StaticResource OldTableTextBoxStyle}" />
                                <TextBox Grid.Column="11" Text="{x:Bind R8Text, Mode=TwoWay}" Style="{StaticResource OldTableTextBoxStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource OldTableCellBorderStyle}" />
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource OldTableCellBorderStyle}" />
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource OldTableCellBorderStyle}" />
                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource OldTableCellBorderStyle}" />
                <CheckBox Grid.Row="2" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="8" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="9" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="10" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="11" HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="3"
            Background="{StaticResource LoopBandBrush}"
            BorderBrush="{StaticResource LoopBandBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="8">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Идентификация зонда" Style="{StaticResource CaptionTextBlockStyle}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock><Run Text="Тип: " /><Run Text="{x:Bind ViewModel.ToolTypeName, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Кол-во TX: " /><Run Text="{x:Bind ViewModel.TransmitterCountText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Модификация: " /><Run Text="{x:Bind ViewModel.ModificationText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Номер: " /><Run Text="{x:Bind ViewModel.NumberText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Серийный №: " /><Run Text="{x:Bind ViewModel.SerialText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Позиция R1: " /><Run Text="{x:Bind ViewModel.RxPositionText, Mode=OneWay}" /></TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                        <TextBlock><Run Text="Сигнатура: " /><Run Text="{x:Bind ViewModel.SignatureText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Pallet: " /><Run Text="{x:Bind ViewModel.PaletteText, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Кадров принято: " /><Run Text="{x:Bind ViewModel.FrameCount, Mode=OneWay}" /></TextBlock>
                        <TextBlock><Run Text="Локальный воздух: " /><Run Text="{x:Bind ViewModel.LocalAirState, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Grid>

                <Button
                    Grid.Column="1"
                    Content="Рапорт"
                    Command="{x:Bind ViewModel.ReportCommand}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </Border>

        <InfoBar
            Grid.Row="4"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Page>
