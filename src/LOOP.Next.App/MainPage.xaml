<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LOOP_Next_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:LOOP_Next_App.ViewModels"
    xmlns:controls="using:LOOP_Next_App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="LoopBandBrush" Color="#F4F4F4" />
        <SolidColorBrush x:Key="LoopBandBorderBrush" Color="#C8C8C8" />
        <SolidColorBrush x:Key="OldTableBorderBrush" Color="#9A9A9A" />
        <SolidColorBrush x:Key="OldTableBackgroundBrush" Color="#F1F1F1" />
        <SolidColorBrush x:Key="OldTableCellBrush" Color="#FFFFFF" />

        <Style x:Key="OldTableCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource OldTableBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource OldTableCellBrush}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- Ячейка с той же рамкой, но без белого фона: для строки номиналов сопротивлений R1..R8. -->
        <Style
            x:Key="OldTableCellOutlineBorderStyle"
            TargetType="Border"
            BasedOn="{StaticResource OldTableCellBorderStyle}">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="OldTableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OldTableCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OldTableValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style
            x:Key="ResistanceTableValueTextStyle"
            TargetType="TextBlock"
            BasedOn="{StaticResource OldTableValueTextStyle}">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ResistanceHeaderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ResistanceHeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource OldTableCellBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OldTableBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="OldTableTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="RingValueTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Карточка вкладки "Поверка кольца": единый корпоративный вид панелей. -->
        <Style x:Key="RingCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- Заголовок секции вкладки "Поверка кольца". -->
        <Style x:Key="RingSectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Подпись поля/строки вкладки "Поверка кольца": приглушённый вторичный тон. -->
        <Style x:Key="RingFieldLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Укрупнённая подпись строки для растянутых на всю ширину таблиц поверки. -->
        <Style x:Key="RingTableLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Значение растянутой таблицы поверки: занимает всю ширину ячейки, увеличенный шрифт. -->
        <Style x:Key="RingValueStretchTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="IdentificationPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="IdentificationLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IdentificationValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Заголовок секции идентификации и статуса: единый строгий стиль для обеих карточек. -->
        <Style x:Key="IdentificationSectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Компактный контейнер значения: сохраняет рамку технических данных, но без избыточной ширины. -->
        <Style x:Key="IdentificationCompactValueBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <!--
            Вкладка "Документация": корпоративный типографский язык руководства.
            Палитра намеренно повторяет Excel-рапорт (LoopReportExcelBuilder):
            тёмно-синий #17365D, акцентный синий #2F75B5, светлые подложки
            #EAF2F8 / #F3F6F9, отбивки #D5DEE8, текст #1F2937 и #64748B.
        -->
        <SolidColorBrush x:Key="DocDeepBlueBrush" Color="#17365D" />
        <SolidColorBrush x:Key="DocAccentBlueBrush" Color="#2F75B5" />
        <SolidColorBrush x:Key="DocRuleBrush" Color="#D5DEE8" />
        <SolidColorBrush x:Key="DocBodyTextBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="DocMutedTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="DocSheetBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DocCanvasBrush" Color="#F3F6F9" />
        <SolidColorBrush x:Key="DocInfoFillBrush" Color="#EAF2F8" />
        <SolidColorBrush x:Key="DocCriticalFillBrush" Color="#FBF3F3" />
        <SolidColorBrush x:Key="DocCriticalAccentBrush" Color="#C00000" />

        <Style x:Key="DocSubHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource DocAccentBlueBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <Style x:Key="DocTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource DocBodyTextBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="DocBulletTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DocTextStyle}">
            <Setter Property="Margin" Value="16,0,0,6" />
        </Style>

        <Style x:Key="DocNoteTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DocTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource DocMutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!--
            Выноски оформлены левой акцентной полосой на светлой подложке:
            строгий приём технической документации без декоративных рамок.
        -->
        <Style x:Key="DocCriticalBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DocCriticalFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DocCriticalAccentBrush}" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="CornerRadius" Value="0,3,3,0" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>

        <Style x:Key="DocHintBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DocInfoFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DocAccentBlueBrush}" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="CornerRadius" Value="0,3,3,0" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>

    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="RootTabs"
            Grid.Row="0"
            TabWidthMode="SizeToContent"
            IsAddTabButtonVisible="False"
            SelectedIndex="0"
            SelectionChanged="RootTabs_SelectionChanged"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <TabViewItem Header="Главная" IsClosable="False" />
            <TabViewItem Header="Поверка кольца" IsClosable="False" />
            <TabViewItem Header="Настройки" IsClosable="False" />
            <TabViewItem Header="Документация" IsClosable="False" />
        </TabView>

        <Border
            x:Name="MainConnectionPanel"
            Grid.Row="1"
            Background="{StaticResource LoopBandBrush}"
            BorderBrush="{StaticResource LoopBandBorderBrush}"
            BorderThickness="0,1,0,1"
            Padding="6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="6" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Усреднение:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="88" ItemsSource="{x:Bind ViewModel.AveragingOptions}" SelectedItem="{x:Bind ViewModel.SelectedAveraging, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Порог %:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Width="88" ItemsSource="{x:Bind ViewModel.ThresholdOptions}" SelectedItem="{x:Bind ViewModel.ThresholdPercent, Mode=TwoWay}" />
                </Grid>

                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Margin="6,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    Command="{x:Bind ViewModel.TogglePollingCommand}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PollingText, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.PollingGlyph, Mode=OneWay}" FontSize="13" />
                </Button>

                <StackPanel Grid.Column="2" Spacing="4">
                    <Button
                        Width="170"
                        Content="{x:Bind ViewModel.ToolToggleText, Mode=OneWay}"
                        Background="{x:Bind ViewModel.ToolButtonBackground, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.ToolButtonForeground, Mode=OneWay}"
                        FontWeight="SemiBold"
                        IsEnabled="{x:Bind ViewModel.CanToggleTool, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleToolCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox
                            Width="134"
                            ItemsSource="{x:Bind ViewModel.ToolPorts}"
                            SelectedItem="{x:Bind ViewModel.SelectedToolPort, Mode=TwoWay}"
                            PlaceholderText="COM прибора" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{x:Bind ViewModel.RefreshPortsCommand}"
                            ToolTipService.ToolTip="Обновить COM-порты прибора">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="4">
                    <Button
                        Width="170"
                        Content="{x:Bind ViewModel.RingToggleText, Mode=OneWay}"
                        Background="{x:Bind ViewModel.RingButtonBackground, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.RingButtonForeground, Mode=OneWay}"
                        FontWeight="SemiBold"
                        IsEnabled="{x:Bind ViewModel.CanToggleRing, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleRingCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox
                            Width="134"
                            ItemsSource="{x:Bind ViewModel.RingPorts}"
                            SelectedItem="{x:Bind ViewModel.SelectedRingPort, Mode=TwoWay}"
                            PlaceholderText="COM кольца" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            Command="{x:Bind ViewModel.RefreshPortsCommand}"
                            ToolTipService.ToolTip="Обновить COM-порты кольца">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" Spacing="4">
                    <Button
                        Width="170"
                        Content="{x:Bind ViewModel.LocalAirButtonText, Mode=OneWay}"
                        Background="{x:Bind ViewModel.LocalAirButtonBackground, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.LocalAirButtonForeground, Mode=OneWay}"
                        FontWeight="{x:Bind ViewModel.LocalAirButtonFontWeight, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                        Command="{x:Bind ViewModel.LocalAirCommand}" />
                    <ComboBox
                        Width="170"
                        ItemsSource="{x:Bind ViewModel.FrameCountOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedFrameCount, Mode=TwoWay}"
                        PlaceholderText="Кол-во кадров" />
                </StackPanel>

                <ToggleButton
                    Grid.Column="5"
                    Width="148"
                    Height="32"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.CanToggleAutoMode, Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.IsAutoMode, Mode=TwoWay}">
                    <TextBlock Text="Режим АВТО" TextAlignment="Center" />
                </ToggleButton>
            </Grid>
        </Border>

        <Grid
            Grid.Row="2"
            Margin="0,0,8,0"
            RowSpacing="8"
            VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                x:Name="MainResistanceTable"
                Grid.Row="0"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
                <Grid
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource OldTableBackgroundBrush}"
                    Padding="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104*" />
                        <ColumnDefinition Width="130*" />
                        <ColumnDefinition Width="424*" />
                        <ColumnDefinition Width="88*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                        <ColumnDefinition Width="81*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource OldTableCellBorderStyle}">
                        <TextBlock Text="№ Зонда" Style="{StaticResource OldTableHeaderTextStyle}" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource OldTableCellBorderStyle}">
                        <TextBlock Text="Воздух" Style="{StaticResource OldTableHeaderTextStyle}" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource OldTableCellBorderStyle}">
                        <Grid Margin="4,2,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.ScaleMinus3PercentLabel, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="13" />
                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.ScaleMinus2PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="13" />
                            <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.ScaleMinus1PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="13" />
                            <TextBlock Grid.Column="5" Grid.ColumnSpan="2" Text="0%" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="7" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.ScalePlus1PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="13" />
                            <TextBlock Grid.Column="9" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.ScalePlus2PercentLabel, Mode=OneWay}" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="13" />
                            <TextBlock Grid.Column="11" Text="{x:Bind ViewModel.ScalePlus3PercentLabel, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource OldTableHeaderTextStyle}" FontSize="13" />

                            <Rectangle Grid.Row="1" Grid.Column="0" Width="1" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Width="1" Height="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Width="1" Height="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" Width="2" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="7" Grid.ColumnSpan="2" Width="1" Height="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="9" Grid.ColumnSpan="2" Width="1" Height="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Rectangle Grid.Row="1" Grid.Column="11" Width="1" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource OldTableCellBorderStyle}">
                        <TextBlock Text="УЭС, Ом" Style="{StaticResource OldTableHeaderTextStyle}" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource OldTableCellBorderStyle}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                IsChecked="{x:Bind ViewModel.ReportR1Selected, Mode=TwoWay}"
                                Style="{StaticResource ResistanceHeaderCheckBoxStyle}"
                                AutomationProperties.Name="Добавить R1 в рапорт"
                                ToolTipService.ToolTip="R1 в рапорт" />
                            <Button
                                Grid.Column="1"
                                Content="R1"
                                Command="{x:Bind ViewModel.RunResistanceCommand}"
                                CommandParameter="1"
                                IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
                                Style="{StaticResource ResistanceHeaderButtonStyle}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource OldTableCellBorderStyle}">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                IsChecked="{x:Bind ViewModel.ReportR2Selected, Mode=TwoWay}"
                                Style="{StaticResource ResistanceHeaderCheckBoxStyle}"
                                AutomationProperties.Name="Добавить R2 в рапорт"
                                ToolTipService.ToolTip="R2 в рапорт" />
                            <Button
                                Grid.Column="1"
                                Content="R2"
                                Command="{x:Bind ViewModel.RunResistanceCommand}"
                                CommandParameter="2"
                                IsEnabled="{x:Bind ViewModel.CanStartSingleResistance, Mode=OneWay}"
