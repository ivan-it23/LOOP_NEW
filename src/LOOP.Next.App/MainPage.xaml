                                <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.RingCalibrationRows}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout Orientation="Horizontal" ItemsStretch="Fill" MinItemWidth="52" MinItemHeight="38" MinColumnSpacing="4" MinRowSpacing="4" MaximumRowsOrColumns="10" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RingCalibrationRowViewModel">
                                            <TextBox
