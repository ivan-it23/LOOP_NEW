<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="LOOP_Next_App.Controls.DocSectionHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch">

    <!--
        Заголовок раздела руководства: номер в корпоративном синем поле,
        название и тонкая отбивка. Палитра совпадает с Excel-рапортом
        (LoopReportExcelBuilder), чтобы приложение и документ выглядели
        как один продукт.
    -->
    <StackPanel Margin="0,28,0,12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="30"
                Height="30"
                VerticalAlignment="Center"
                Background="#2F75B5"
                CornerRadius="3">
                <TextBlock
                    x:Name="NumberText"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                FontSize="19"
                FontWeight="SemiBold"
                Foreground="#17365D"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
        </Grid>

        <Border Height="1" Margin="0,12,0,0" Background="#D5DEE8" />
    </StackPanel>
</UserControl>
