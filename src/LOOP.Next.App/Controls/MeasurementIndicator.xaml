<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LOOP_Next_App.Controls.MeasurementIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Canvas x:Name="IndicatorCanvas" SizeChanged="OnCanvasSizeChanged">
            <Rectangle x:Name="ZoneRed1" Fill="Red" />
            <Rectangle x:Name="ZoneYellow1" Fill="Yellow" />
            <Rectangle x:Name="ZoneGreen1" Fill="LimeGreen" />
            <Rectangle x:Name="ZoneGreen2" Fill="LimeGreen" />
            <Rectangle x:Name="ZoneYellow2" Fill="Yellow" />
            <Rectangle x:Name="ZoneRed2" Fill="Red" />

            <Rectangle x:Name="AverageCursor" Fill="Black" Width="5" />
        </Canvas>
    </Grid>
</UserControl>
